API_PORT=8000
WEB_PORT=3000
# Local Next.js rewrite target. On Render set BACKEND_URL to the API service URL.
BACKEND_URL=http://127.0.0.1:8000
# Comma-separated frontend origins for CORS (Render web URL).
INCIDENT_AGENT_CORS_ORIGINS=
INCIDENT_AGENT_ENVIRONMENT=local
INCIDENT_AGENT_LOG_LEVEL=INFO
INCIDENT_AGENT_JSON_LOGS=true
# Optional. Leave blank to use grounded heuristic reports.
INCIDENT_AGENT_OPENAI_API_KEY=
# Optional Groq (OpenAI-compatible). Copy to .env and set:
# INCIDENT_AGENT_LLM_PROVIDER=groq
INCIDENT_AGENT_GROQ_API_KEY=
